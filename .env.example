# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxhowlomfolxpotqnyrr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Payment gateway (Midtrans)
# Server key & client key dari dashboard Midtrans.
# Penting: sandbox dan production sama-sama berawalan "Mid-". Yang membedakan
# adalah dari dashboard mana kamu mengambilnya (dashboard.sandbox.midtrans.com
# vs dashboard.midtrans.com) serta flag MIDTRANS_IS_PRODUCTION di bawah.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY dipakai oleh Snap.js di sisi browser.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" = production (uang asli!), selain itu (atau kosong) = sandbox.
MIDTRANS_IS_PRODUCTION=false
# Untuk memuat SDK Snap.js di browser (sandbox vs production) — sama nilainya dgn di atas.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
